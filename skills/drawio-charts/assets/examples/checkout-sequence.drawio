<mxfile host="app.diagrams.net" agent="draw.io" version="21.0.0">
  <diagram id="checkout-sequence" name="Checkout Sequence">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!--
          Lifelines are containers: header box (size=40) plus a dashed line down.
          They sit 220px apart. Activation bars are children of their lifeline, so
          their x/y are relative to it: x=55 centres a 10px bar on a 120px lifeline.
          Messages attach to bars; exitDy/entryDy is the px offset from the top of
          the bar, which fixes the message's height.
        -->
        <mxCell id="browser" value="Browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="120" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="Checkout API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="260" y="40" width="120" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="gateway" value="Payment Gateway" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="480" y="40" width="120" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="Orders DB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="700" y="40" width="120" height="400" as="geometry"/>
        </mxCell>

        <!-- Activation bars (absolute top: browser 110, api 120, gateway 160, db 240) -->
        <mxCell id="browser-act" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;" parent="browser" vertex="1">
          <mxGeometry x="55" y="70" width="10" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="api-act" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;" parent="api" vertex="1">
          <mxGeometry x="55" y="80" width="10" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="gateway-act" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;" parent="gateway" vertex="1">
          <mxGeometry x="55" y="120" width="10" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="db-act" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;" parent="db" vertex="1">
          <mxGeometry x="55" y="200" width="10" height="60" as="geometry"/>
        </mxCell>

        <!-- Messages, 40px apart. Calls: solid + filled arrow. Replies: dashed + open arrow. -->
        <mxCell id="m1" value="POST /checkout" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=20;entryX=0;entryY=0;entryDx=0;entryDy=10;" parent="1" source="browser-act" target="api-act" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="authorize(card, amount)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=50;entryX=0;entryY=0;entryDx=0;entryDy=10;" parent="1" source="api-act" target="gateway-act" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="approved, auth_id" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0;exitY=0;exitDx=0;exitDy=50;entryX=1;entryY=0;entryDx=0;entryDy=90;" parent="1" source="gateway-act" target="api-act" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="INSERT order" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=130;entryX=0;entryY=0;entryDx=0;entryDy=10;" parent="1" source="api-act" target="db-act" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="order_id" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0;exitY=0;exitDx=0;exitDy=50;entryX=1;entryY=0;entryDx=0;entryDy=170;" parent="1" source="db-act" target="api-act" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="201 Created {order_id}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0;exitY=0;exitDx=0;exitDy=210;entryX=1;entryY=0;entryDx=0;entryDy=220;" parent="1" source="api-act" target="browser-act" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
