<mxfile host="app.diagrams.net" agent="draw.io" version="21.0.0">
  <diagram id="password-reset" name="Password Reset Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Main path: one column, top to bottom, centred on x=540 -->
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="480" y="20" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="request" value="User requests reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="460" y="110" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="registered" value="Email registered?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="470" y="210" width="140" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="send-email" value="Send reset link email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="460" y="350" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="link-valid" value="Link used within 1 hour?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="470" y="450" width="140" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="new-password" value="Set new password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="460" y="590" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="done" value="Password changed" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="480" y="690" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- Side branches: a second column to the right -->
        <mxCell id="generic-message" value="Show &quot;check your inbox&quot; (don't reveal whether the email exists)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="720" y="230" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="expired" value="Show &quot;link expired&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="720" y="470" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- Connectors -->
        <mxCell id="e-start-request" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#666666;" parent="1" source="start" target="request" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-request-registered" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#666666;" parent="1" source="request" target="registered" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Short labels can go in the edge's own value -->
        <mxCell id="e-registered-yes" value="Yes" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#666666;" parent="1" source="registered" target="send-email" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-registered-no" value="No" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#666666;" parent="1" source="registered" target="generic-message" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-send-link" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#666666;" parent="1" source="send-email" target="link-valid" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-link-yes" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#666666;" parent="1" source="link-valid" target="new-password" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Or as a child label cell: parent is the edge, x runs -1 (source) .. 1 (target) -->
        <mxCell id="e-link-yes-label" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;" parent="e-link-yes" vertex="1" connectable="0">
          <mxGeometry x="-0.3" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-link-no" value="No" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#666666;" parent="1" source="link-valid" target="expired" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Loop back: a waypoint keeps the edge from crossing the main column -->
        <mxCell id="e-expired-retry" value="Try again" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#666666;dashed=1;" parent="1" source="expired" target="request" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="810" y="140"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-new-done" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#666666;" parent="1" source="new-password" target="done" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
